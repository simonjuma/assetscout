# =============================================================================
# AssetScout — environment template. Copy to `.env.local` and fill in.
# NEVER commit a filled-in copy: `.env*` is git-ignored (see .gitignore).
# =============================================================================

# --- Canonical app origin -----------------------------------------------------
# Used for Stripe success_url / cancel_url / portal return_url and sitemap.
# Must be an absolute http(s) origin, and https:// in production.
# Host headers are never trusted for redirects.
APP_URL="http://localhost:3000"

# --- Supabase -----------------------------------------------------------------
# Project settings -> API. Browser-safe values are read by RLS-scoped clients.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SERVER ONLY. Bypasses RLS. Used by the Stripe webhook, the ingestion runner and
# admin provisioning. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (server only) -----------------------------------------------------
# Dashboard -> Developers -> API keys. Use test keys locally, live keys in prod.
STRIPE_SECRET_KEY=""
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret,
# or the `whsec_…` printed by `stripe listen` for local testing.
STRIPE_WEBHOOK_SECRET=""
# OPTIONAL: only needed if you add Stripe Elements/Stripe.js on the client.
# Checkout here is redirect-based, so this is not required.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Stripe Price IDs (optional but recommended) ------------------------------
# Stripe Prices are immutable, so the database (`public.plan_prices`) is the
# source of truth. Setting these lets `npm run billing:sync` create/refresh the
# DB rows from Stripe (verifying amount + currency + interval in the process).
# Without them, `plan_prices` must be populated by hand (or by SQL in the
# Supabase dashboard) before checkout can start.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_AGENCY_MONTHLY=""
STRIPE_PRICE_AGENCY_ANNUAL=""
STRIPE_BILLING_CURRENCY="USD"

# --- Ingestion -----------------------------------------------------------------
# OPTIONAL. CZDS (Zone File Access) is ICANN's authenticated bulk zone-file
# programme; it requires an approved ICANN account. Leave every value blank to
# keep the optional `czds` provider disabled — the CZDS *metadata* provider
# (public, unauthenticated) works without credentials.
CZDS_USERNAME=""
CZDS_PASSWORD=""

# OPTIONAL. Product Hunt has no public API for developer tokens any more; the
# provider is therefore disabled unless a token is supplied.
# PRODUCTHUNT_TOKEN=""

# OPTIONAL. Overrides the descriptive User-Agent sent to public data sources
# (they use it to contact you). Must contain a reachable URL or email.
INGEST_CONTACT="AssetScout/1.0 (+https://example.com; data-freshness@example.com)"

# --- Scheduled ingestion -------------------------------------------------------
# Sent by the scheduler as `Authorization: Bearer <CRON_SECRET>` on
# GET /api/cron/ingest. Leave blank to disable the endpoint entirely.
CRON_SECRET=""