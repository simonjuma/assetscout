{
  "name": "assetscout",
  "version": "0.1.0",
  "private": true,
  "description": "AssetScout - Digital asset discovery, verification and opportunity intelligence. Next.js (App Router) + Supabase + Stripe subscription billing.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup:swc-wasm": "node scripts/setup-swc-wasm.mjs",
    "postinstall": "node scripts/setup-swc-wasm.mjs",
    "prebuild": "node scripts/setup-swc-wasm.mjs",
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test --test-reporter=spec tests/",
    "test:bypass": "node --test tests/bypass.test.ts",
    "ingest": "node scripts/ingest.mjs",
    "billing:sync": "node scripts/sync-billing.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "15.5.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.2"
  }
}